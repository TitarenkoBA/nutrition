---
import Base from "../layouts/Base.astro";
import { url } from "../lib/site";
---

<Base title="Страница не найдена" noindex>
  <section class="section">
    <div class="container" style="text-align:center;max-width:640px">
      <span class="eyebrow">Ошибка 404</span>
      <h1>Такой страницы нет</h1>
      <p class="lead" style="margin-inline:auto">Возможно, ссылка устарела. Начните с главной или заполните анкету.</p>
      <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:28px">
        <a class="btn btn--sage" href={url("/")}>На главную</a>
        <a class="btn btn--ghost" href={url("/anketa/")}>Анкета</a>
      </p>
    </div>
  </section>
</Base>
